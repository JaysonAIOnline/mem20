# Model / embedding caches
# These are downloaded on demand and can contain symlink loops (HF snapshots
# link back into ../../), which breaks `git add`, `git diff --stat`, and any
# checkout on a filesystem without symlink support. They are reproducible from
# the model id, so they belong in neither git nor a backup.
**/data/cache/
**/huggingface/
**/.cache/huggingface/
**/models--*/
**/snapshots/
**/.no_exist/
CACHEDIR.TAG
*.npz.cache/

# Blender/Unity cache
*.blend*

# Rust build artifacts
**/target/
**/Cargo.lock

# Node
node_modules/

# Runtime data, not source: the harness control surface and mem20store mirror
# project state here. A baseline commit should carry the code, not a snapshot of
# whatever happened to be running.
entries/*.json

# Generated by mem20dreamz/OREO during dream runs. Proof the engine works, but
# timestamped build output is noise in a source baseline.
mem20agentz/built/app_*.py

# Test scaffolding that writes into the package directory.
mem20messenger/.test-home/

# Downloaded model weights (HuggingFace cache). The snapshot symlinks point into
# a blobs/ directory that is not present, so git's resolver spins on them and
# wedges every status/add/push. Weights are fetched at runtime, not committed.
mem20owebz/data/cache/

# Chat front-end runtime state. vector_db/ holds a regenerable Chroma SQLite
# index and uploads/ holds what users sent through the UI; neither is source,
# and the vector index is rebuilt from the store on first run.
mem20owebz/data/vector_db/
mem20owebz/data/uploads/

# Point-in-time kanban snapshots taken by hand before the 2026-10-01 merge.
# Superseded by the live board; the source of truth is kanban/.
backups/kanban-merge-*/
