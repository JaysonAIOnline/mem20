# Jayson 2.0-beta1 — Environment Variables Template
# Copy this file to .env and fill in your actual keys
# Get keys from: CREDITS.md

# ============ PRIORITY (Best Free Tiers) ============
GEMINI_API_KEY=your_gemini_key_here         # https://aistudio.google.com/app/apikey
GROQ_API_KEY=your_groq_key_here             # https://console.groq.com/keys
ANYAPI_API_KEY=your_anyapi_key_here          # https://anyapi.ai
OPENROUTER_API_KEY=your_openrouter_key_here  # https://openrouter.ai/keys

# ============ CLOUDFLARE ============
CLOUDFLARE_API_KEY=your_cloudflare_key_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ============ QWEN / ALIBABA ============
DASHSCOPE_API_KEY=your_dashscope_key_here

# ============ NVIDIA ============
NVIDIA_API_KEY=your_nvidia_key_here

# ============ TOGETHER ============
TOGETHER_API_KEY=your_together_key_here

# ============ HUGGING FACE ============
HF_TOKEN=your_hf_token_here

# ============ DEEPSEEK ============
DEEPSEEK_API_KEY=your_deepseek_key_here

# ============ MISTRAL ============
MISTRAL_API_KEY=your_mistral_key_here

# ============ COHERE ============
COHERE_API_KEY=your_cohere_key_here

# ============ XAI / GROK ============
XAI_API_KEY=your_xai_key_here

# ============ MICROSOFT FOUNDRY / AZURE ============
AZURE_API_KEY=your_azure_key_here
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============ AWS BEDROCK ============
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION_NAME=us-east-1

# ============ ORACLE CLOUD INFRASTRUCTURE (OCI) ============
OCI_API_KEY=your_oci_key_here
OCI_GENAI_ENDPOINT=your_oci_endpoint_here

# ============ SILICONFLOW ============
SILICONFLOW_API_KEY=your_siliconflow_key_here

# ============ MOONSHOT / KIMI ============
MOONSHOT_API_KEY=your_moonshot_key_here

# ============ ZHIPU / Z.AI ============
ZHIPU_API_KEY=your_zhipu_key_here

# ============ SAMBANOVA ============
SAMBANOVA_API_KEY=your_sambanova_key_here

# ============ CEREBRAS ============
CEREBRAS_API_KEY=your_cerebras_key_here

# ============ FIREWORKS ============
FIREWORKS_API_KEY=your_fireworks_key_here

# ============ NOVITA ============
NOVITA_API_KEY=your_novita_key_here

# ============ CREATIVE GENERATION (optional) ============
LUMA_API_KEY=your_luma_key_here
MESHY_API_KEY=your_meshy_key_here
TRIPO_API_KEY=your_tripo_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============ RESOURCE BRIDGE (3.0) ============
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
BACKUP_ACCESS_KEY=your_backup_key
BACKUP_SECRET_KEY=your_backup_secret_key
